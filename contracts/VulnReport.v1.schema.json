{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adversaryforge/contracts/vulnreport/v1",
  "version": "v1",
  "$defs": {
    "AttackCategory": {
      "enum": [
        "prompt_injection",
        "data_exfiltration",
        "state_corruption",
        "tool_misuse",
        "denial_of_service",
        "identity_role"
      ],
      "title": "AttackCategory",
      "type": "string"
    },
    "OwaspLlm": {
      "enum": [
        "LLM01:2025-Prompt Injection",
        "LLM02:2025-Sensitive Information Disclosure",
        "LLM03:2025-Supply Chain",
        "LLM04:2025-Data and Model Poisoning",
        "LLM05:2025-Improper Output Handling",
        "LLM06:2025-Excessive Agency",
        "LLM08:2025-Vector and Embedding Weaknesses",
        "LLM10:2025-Unbounded Consumption"
      ],
      "title": "OwaspLlm",
      "type": "string"
    },
    "OwaspWeb": {
      "enum": [
        "A01:2021-Broken Access Control",
        "A02:2021-Cryptographic Failures",
        "A03:2021-Injection",
        "A04:2021-Insecure Design",
        "A05:2021-Security Misconfiguration",
        "A06:2021-Vulnerable and Outdated Components",
        "A07:2021-Identification and Authentication Failures",
        "A08:2021-Software and Data Integrity Failures",
        "A09:2021-Security Logging and Monitoring Failures",
        "A10:2021-SSRF"
      ],
      "title": "OwaspWeb",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A professional vulnerability report \u2014 reproducible by an engineer who was\nnot present when the exploit was found.",
  "properties": {
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "exploit_id": {
      "title": "Exploit Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "category": {
      "$ref": "#/$defs/AttackCategory"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "published",
        "fixed",
        "wont-fix",
        "false-positive"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "clinical_impact": {
      "title": "Clinical Impact",
      "type": "string"
    },
    "reproduction": {
      "description": "Numbered, copy-pasteable steps.",
      "items": {
        "type": "string"
      },
      "title": "Reproduction",
      "type": "array"
    },
    "observed_behavior": {
      "title": "Observed Behavior",
      "type": "string"
    },
    "expected_behavior": {
      "title": "Expected Behavior",
      "type": "string"
    },
    "remediation": {
      "title": "Remediation",
      "type": "string"
    },
    "fix_validation": {
      "default": "",
      "title": "Fix Validation",
      "type": "string"
    },
    "owasp_web": {
      "items": {
        "$ref": "#/$defs/OwaspWeb"
      },
      "title": "Owasp Web",
      "type": "array"
    },
    "owasp_llm": {
      "items": {
        "$ref": "#/$defs/OwaspLlm"
      },
      "title": "Owasp Llm",
      "type": "array"
    },
    "requires_human_approval": {
      "default": false,
      "title": "Requires Human Approval",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "exploit_id",
    "title",
    "severity",
    "category",
    "summary",
    "clinical_impact",
    "reproduction",
    "observed_behavior",
    "expected_behavior",
    "remediation"
  ],
  "title": "VulnReport",
  "type": "object"
}
