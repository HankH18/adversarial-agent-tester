# AdversaryForge — operator secrets & config.
# Copy to `.env` (git-ignored) and fill in. The platform reads this via adversaryforge.config.Settings.
#
# ─────────────────────────────────────────────────────────────────────────────
# TWO SECRETS UNLOCK FULL LIVE COVERAGE. The platform runs and produces real
# evidence WITHOUT them (unauthenticated live surface + deterministic Judge +
# subagent-driven attacks), but these turn on the authenticated attack plane and
# the platform's own in-process LLM agents.
# ─────────────────────────────────────────────────────────────────────────────

# (1) Claude API key — powers the platform's in-process Red Team mutator, the
#     LLM-second Judge pass, and the Documentation Agent. WITHOUT it, those roles
#     are driven by Claude Code subagents at build time and the Judge runs
#     deterministic-only. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model routing (safe defaults; override only if you know why).
ADVERSARYFORGE_JUDGE_MODEL=claude-opus-4-8
ADVERSARYFORGE_REDTEAM_MODEL=claude-sonnet-5
ADVERSARYFORGE_DOC_MODEL=claude-sonnet-5

# (2) Live-target session — unlocks the AUTHENTICATED attack plane (prompt
#     injection, PHI exfil, multi-turn poisoning) against the deployed target.
#     How to get it: sign in at https://agentforge.hankholcomb.com as a
#     physician, open DevTools → Application → Cookies, copy the session cookie
#     value. Paste the WHOLE `Cookie:` header value (name=value; name2=value2).
#     Without it, the platform still runs the UNAUTHENTICATED live surface.
AGENTFORGE_SESSION_COOKIE=

# ─────────────────────────────────────────────────────────────────────────────
# Target configuration (defaults point at the authorized live deploy).
# ─────────────────────────────────────────────────────────────────────────────
ADVERSARYFORGE_TARGET_BASE_URL=https://agentforge.hankholcomb.com

# Self-throttle: the target has NO inbound rate limiting, so the PLATFORM must
# not become the thing that takes it down. Max concurrent + min gap between
# requests (seconds). Conservative by default.
ADVERSARYFORGE_MAX_CONCURRENCY=2
ADVERSARYFORGE_MIN_REQUEST_GAP_S=0.5

# Optional: point at a locally stood-up target in auth_mode=disabled for
# free/unlimited iteration (Stage 1 "locally" requirement).
# ADVERSARYFORGE_TARGET_BASE_URL=http://localhost:8000

# Cost governor: halt a campaign that burns this many USD without a confirmed
# finding (no-signal halt). 0 = disabled.
ADVERSARYFORGE_NOSIGNAL_HALT_USD=2.0
